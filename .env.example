# Postgres started by docker-compose.yml
DATABASE_URL=postgresql://rag:rag@localhost:5433/pubmed_rag

# Set this to use real OpenAI embeddings + chat. Without it the demo falls back
# to an offline stand-in embedder (pipeline works end to end, but similarity is
# lexical, not semantic -- fine for testing the plumbing).
# OPENAI_API_KEY=sk-...

# EMBEDDINGS=openai              # or "hashbow" (offline stand-in)
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536                 # -3 models support truncation, e.g. 512.
                                 # Changing this after init-db requires
                                 # "DROP TABLE articles;" + init-db + load.
# CHAT_MODEL=gpt-4o-mini

# Optional: an NCBI API key raises the E-utilities limit from 3 to 10 req/s
# NCBI_API_KEY=
# NCBI_EMAIL=you@example.com
